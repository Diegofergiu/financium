/**
 * Reglas de seguridad de Mi Bolsillo.
 *
 * - /users/{userId}: perfil privado, sólo lo ve y edita su dueño.
 * - /wallets/{walletId}: "libros" contables. Acceso para el dueño (ownerId) o
 *   quien figure en el mapa members (uid -> rol).
 * - /wallets/{walletId}/{sub}/{docId}: datos del libro (movimientos, cheques,
 *   presupuestos, categorías). Cada documento lleva walletOwnerId y
 *   walletMembersMap desnormalizados; además, para crear se verifica contra el
 *   libro real (getAfter permite crear el libro y sus categorías en un mismo lote).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasAccess(data) {
      return signedIn() && (data.ownerId == request.auth.uid || request.auth.uid in data.members);
    }

    function canWriteWallet(data) {
      return signedIn() && (
        data.ownerId == request.auth.uid ||
        (request.auth.uid in data.members && data.members[request.auth.uid] in ['owner', 'editor'])
      );
    }

    function walletPath(walletId) {
      return /databases/$(database)/documents/wallets/$(walletId);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.id == userId;
      allow update: if signedIn() && request.auth.uid == userId && request.resource.data.id == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    /** Sólo cambian estas claves del documento. */
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /** En un mapa (members/memberInfo) sólo cambia la entrada del propio usuario. */
    function onlySelfIn(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    function joiningByInvite(walletId) {
      let inv = get(/databases/$(database)/documents/invites/$(walletId + '__' + myEmail()));
      return request.auth.token.email_verified == true
        && inv.data.status == 'pending'
        && inv.data.walletId == walletId
        && onlyKeys(['members', 'memberInfo', 'updatedAt'])
        && onlySelfIn('members')
        && onlySelfIn('memberInfo')
        && request.resource.data.members[request.auth.uid] == inv.data.role;
    }

    function leavingWallet() {
      return request.auth.uid in resource.data.members
        && !(request.auth.uid in request.resource.data.members)
        && resource.data.ownerId != request.auth.uid
        && onlyKeys(['members', 'memberInfo', 'updatedAt'])
        && onlySelfIn('members');
    }

    match /invites/{inviteId} {
      allow create: if signedIn()
        && get(walletPath(request.resource.data.walletId)).data.ownerId == request.auth.uid
        && inviteId == request.resource.data.walletId + '__' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['editor', 'reader']
        && request.resource.data.status == 'pending'
        && request.resource.data.invitedBy == request.auth.uid;
      allow get, list: if signedIn() && (
        resource.data.invitedBy == request.auth.uid ||
        (request.auth.token.email_verified == true && resource.data.email == myEmail())
      );
      // La persona invitada acepta o rechaza
      allow update: if signedIn()
        && request.auth.token.email_verified == true
        && resource.data.email == myEmail()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && onlyKeys(['status', 'acceptedBy', 'updatedAt']);
      // Quien invitó puede cancelarla
      allow delete: if signedIn() && resource.data.invitedBy == request.auth.uid;
    }

    match /wallets/{walletId} {
      allow get: if hasAccess(resource.data);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members is map
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (
          // Dueño: puede todo, pero sigue figurando como dueño
          (resource.data.ownerId == request.auth.uid && request.resource.data.members[request.auth.uid] == 'owner') ||
          // Editor: nombre/moneda, sin tocar quién tiene acceso
          (canWriteWallet(resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'memberInfo', 'ownerId'])) ||
          leavingWallet() ||
          joiningByInvite(walletId)
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /{sub}/{docId} {
        allow get: if hasAccess(get(walletPath(walletId)).data);
        allow list: if hasAccess(get(walletPath(walletId)).data);

        allow create: if canWriteWallet(getAfter(walletPath(walletId)).data)
          && request.resource.data.walletOwnerId == getAfter(walletPath(walletId)).data.ownerId
          && validAmount(sub);

        allow update: if canWriteWallet(get(walletPath(walletId)).data)
          && request.resource.data.walletOwnerId == resource.data.walletOwnerId
          && validAmount(sub);

        // Al borrar un libro entero puede que el documento del libro ya no exista
        allow delete: if signedIn() && (
          resource.data.walletOwnerId == request.auth.uid ||
          (exists(walletPath(walletId)) && canWriteWallet(get(walletPath(walletId)).data))
        );
      }
    }

    function validAmount(sub) {
      return !(sub in ['transactions', 'checks'])
        || (request.resource.data.amount is number && request.resource.data.amount > 0);
    }
  }
}
